{
  "redirects": [
    { "source": "/vlogs", "destination": "/blog", "permanent": true },
    { "source": "/vlogs/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/lovable-uploads/:path*", "destination": "/uploads/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
